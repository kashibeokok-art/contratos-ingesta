# Copia este archivo como .env y completa las rutas. .env NUNCA va a git.
# Vacío = valor por defecto. Una variable CONT_* mal escrita DETIENE el programa.

# Carpeta local de trabajo (temporales y reportes). Relativa = dentro del proyecto.
CONT_DATA_DIR=data

# Carpetas de Bronze (Excel descargados) y Silver (tablas procesadas).
# Tienen que EXISTIR: el programa no las crea. Vacías = data\bronze y data\silver.
# Ejemplo: \\SERVIDOR\carpeta\contratos\bronze
CONT_BRONZE_DIR=
CONT_SILVER_DIR=

# PostgreSQL (para `contratos publicar-sql`). La conexión SIN la clave, y la clave aparte:
# así una clave con ; ) o espacios no hay que codificarla. La clave NUNCA va a git.
# Ejemplo: host=SERVIDOR port=5433 dbname=cmg_cen user=contratos_carga
CONT_PG_CONEXION=
CONT_PG_CLAVE=
