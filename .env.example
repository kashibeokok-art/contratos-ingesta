# =============================================================================
#  Dónde están las cosas en ESTE equipo (contratos-ingesta)
# =============================================================================
#
# Copia este archivo como .env (en esta misma carpeta) y completa los valores de
# tu equipo. El .env es de cada equipo y tiene la clave: no se copia a otro
# equipo ni se comparte. Este archivo de ejemplo no lleva valores reales.
#
# Reglas:
#   - Escribe las rutas SIN comillas: entre comillas las barras \ se deforman.
#   - Vacío = valor por defecto.
#   - Una variable CONT_* mal escrita detiene el programa y dice cuál es.
#   - Las carpetas tienen que EXISTIR: el programa no las crea. Si la ruta está
#     mal escrita o la red no está conectada, se detiene sin escribir nada.
#
# Hay dos formas de instalarlo (GUIA_MANTENIMIENTO.md, "Instalar en un equipo nuevo"):
#   A) En la red de la empresa: Bronze y Silver en la carpeta compartida.
#   B) En un computador cualquiera: una carpeta elegida, con bronze y silver por separado.
#
# Después de editarlo, prueba con:
#     uv run contratos estado

# Carpeta de trabajo de este equipo: logs\ (lo que hizo cada corrida) y alertas\.
# Relativa = dentro de la carpeta del programa. Tiene que existir.
CONT_DATA_DIR=data

# Bronze: los Excel tal como los entrega el Coordinador, uno por cada cambio.
# Vacía = data\bronze (dentro de CONT_DATA_DIR; esa sí se crea sola).
#   A) \\SERVIDOR\Compartida\Contratos CEN\bronze
#   B) C:\Datos\Contratos\bronze
CONT_BRONZE_DIR=

# Silver: las tablas procesadas (contratos.parquet y contrato_barra.parquet).
# Vacía = data\silver (dentro de CONT_DATA_DIR; esa sí se crea sola).
#   A) \\SERVIDOR\Compartida\Contratos CEN\silver
#   B) C:\Datos\Contratos\silver
CONT_SILVER_DIR=

# PostgreSQL, para publicar las tablas en la base (`contratos publicar-sql`).
# Vacía = no se publica (`actualizar` hace todo lo demás igual).
# La conexión va SIN la clave; si la trae, el programa se detiene y lo dice.
#   host=SERVIDOR port=PUERTO dbname=BASE user=USUARIO
CONT_PG_CONEXION=

# La clave del USUARIO de arriba. Solo en el .env de tu equipo; nunca aparece en
# pantalla ni en los logs.
CONT_PG_CLAVE=
